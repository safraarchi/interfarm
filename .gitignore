*.sw?

# Temporary, Backup & Log Files
*.tmp
*.log
*.bak
*.backup
*~

# Heavy Raw Uncompressed Media
_raw_originals/

# Python & Node Caches (if any)
__pycache__/
*.py[cod]
node_modules/
.npm
